@startuml
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle

actor "Пользователь\n(читатель, библиотекарь,\nадминистратор)" as User

package "Frontend" {
  [Веб-интерфейс] as UI
}

package "Backend" {
  [API / Контроллеры] as Controllers
  [Модуль аутентификации\nи прав] as Auth
  [Бизнес-логика (Сервисы)] as Services
  [Репозитории] as Repos
  [Модуль уведомлений\n(фоновый процесс)] as Notify

  note right of Notify
    Планировщик сервера запускает раз в сутки.
    Не зависит от запросов браузера.
  end note
}

database "Database" {
  [База данных] as DB
}

cloud "Внешние сервисы" {
  [Почтовый сервис (Email)] as Ext
}

User --> UI
UI --> Controllers : HTTPS / REST
Controllers --> Auth : Проверка сессии и прав
Auth --> Repos : Данные для входа и сессии
Controllers --> Services : Вызов после проверки прав
Services --> Repos : Чтение и сохранение
Repos --> DB : SQL
Notify --> Services : Получение выдач\nдля напоминаний
Notify --> Ext : Отправка писем\nв фоновом процессе
@enduml
